{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "icsel layout profile",
  "description": "One layout template as rectangular zones. Points (1/72 inch), origin top-left, y grows downwards.",
  "type": "object",
  "required": ["id", "page", "zones"],
  "properties": {
    "profile_version": {"type": "integer", "const": 1},
    "id": {"type": "string", "minLength": 1},
    "name": {"type": "string"},
    "description": {"type": "string"},
    "kind": {"enum": ["letter", "statement"]},
    "page": {
      "type": "object",
      "required": ["width", "height"],
      "properties": {
        "width": {"type": "number", "exclusiveMinimum": 0},
        "height": {"type": "number", "exclusiveMinimum": 0},
        "units": {"type": "string", "const": "pt"}
      }
    },
    "zones": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["role", "x", "y", "width", "height"],
        "additionalProperties": false,
        "properties": {
          "role": {
            "enum": ["letterhead", "address", "date", "subject", "salutation", "body", "closing", "footer", "unknown", "reference", "table"]
          },
          "x": {"type": "number", "minimum": 0},
          "y": {"type": "number", "minimum": 0},
          "width": {"type": "number", "exclusiveMinimum": 0},
          "height": {"type": "number", "exclusiveMinimum": 0},
          "max_lines": {"type": "integer", "minimum": 1},
          "required": {"type": "boolean"}
        }
      }
    }
  }
}
