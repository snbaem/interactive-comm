# icsel optional AI step. Copy to .env (git-ignored) or set these in your shell.
# The AI step is OFF unless ICSEL_LLM names a backend.
ICSEL_LLM=none
# ICSEL_LLM=anthropic            # needs: pip install -e ".[llm]"

# Anthropic backend settings (all optional)
# ICSEL_LLM_MODEL=claude-opus-5-5
# ICSEL_LLM_EFFORT=low
# ICSEL_LLM_MAX_TOKENS=4000
# ICSEL_LLM_TIMEOUT=60
# ICSEL_LLM_FALLBACKS=1

# Shared settings
# ICSEL_LLM_TASKS=classify,explain   # also: fields, fragments, propose, purpose
#                                    # "explain" and "propose" send no letter text;
#                                    # "fragments" sends only wording shared by letters
# ICSEL_LLM_FIELDS_SEND_TEXT=1       # lets "fields" send letter text (off by default)
# ICSEL_LLM_PURPOSE_SEND_TEXT=1      # lets "purpose" send letter text (off by default)
# ICSEL_AI_CACHE_DIR=out/.ai-cache   # cached replies can quote letter text
# ICSEL_LLM_MIN_CONFIDENCE=0.5
# ICSEL_PROMPTS_DIR=./my-prompts

# Credentials are read by the Anthropic SDK from the environment
# (ANTHROPIC_API_KEY, or an `ant auth login` profile). Never commit a key.
# In `icsel serve` you can enter a key under "AI settings" instead.
# ANTHROPIC_API_KEY=
